# ML Inference
MACHINE_LEARNING_ENABLED=1
MACHINE_LEARNING_CACHE_FOLDER=/tmp/ml_models
MACHINE_LEARNING_EXECUTION_PROVIDER=
MACHINE_LEARNING_DEVICE_ID=0
ONNXRUNTIME_SHARED_LIBRARY_PATH=libonnxruntime.so

# HuggingFace (required for model downloads)
HUGGING_FACE_HUB_TOKEN=

# Job Queue Scheduling
ML_JOB_POLL_INTERVAL=5        # seconds between worker polls
ML_JOB_BATCH_SIZE=8           # jobs per batch (4-8 CPU, 16-32 GPU)
ML_JOB_FLUSH_INTERVAL=2       # seconds before flushing partial batch

# Face Recognition
MACHINE_LEARNING_FACIAL_RECOGNITION_MIN_SCORE=0.7
MACHINE_LEARNING_FACIAL_RECOGNITION_MAX_DISTANCE=0.5
MACHINE_LEARNING_FACIAL_RECOGNITION_MIN_FACES=3

# Vector Search (optional — if set, use usearch HNSW index; otherwise brute-force in Go)
# Requires usearch system library installed: see https://github.com/unum-cloud/usearch
USEARCH_INDEX_PATH=
